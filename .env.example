# Copy to .env.local and fill with your Supabase project values.
# Never commit real secrets. Never expose a service-role key to the app.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional absolute site URL used when constructing auth redirects server-side.
# In local development, http://localhost:3000 is used when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email. Optional in local development.
# Without these, invitations and business events still succeed and in-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM=

